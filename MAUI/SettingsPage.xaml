<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI.SettingsPage"
             Title="Настройки">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Текущая дата"
                   Style="{StaticResource SettingsHeaderLabelStyle}" />
            <DatePicker x:Name="CurrentDatePicker" />

            <Label Text="Цвет оформления"
                   Style="{StaticResource SettingsHeaderLabelStyle}" />
            <Picker x:Name="PrimaryColorPicker"
                    Title="Выберите цвет" />

            <Label Text="Шрифт"
                   Style="{StaticResource SettingsHeaderLabelStyle}" />
            <Picker x:Name="FontFamilyPicker"
                    Title="Выберите шрифт" />

            <Label Text="Размер шрифта"
                   Style="{StaticResource SettingsHeaderLabelStyle}" />
            <Slider x:Name="FontSizeSlider"
                    Minimum="12"
                    Maximum="22"
                    ValueChanged="OnFontSizeChanged" />
            <Label x:Name="FontSizeValueLabel"
                   HorizontalOptions="End"
                   TextColor="{DynamicResource AppSecondaryTextColor}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Text="Сброс"
                        Clicked="OnResetClicked"
                        BackgroundColor="{DynamicResource AppDangerColor}" />

                <Button Grid.Column="1"
                        Text="Сохранить"
                        Clicked="OnSaveClicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
