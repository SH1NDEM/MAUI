<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MAUI"
             x:Class="MAUI.MainPage"
             x:DataType="local:MainPage"
             Title="Ежедневник">

    <Grid Padding="16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Button Grid.Row="0"
                Text="Создать заметку"
                Clicked="OnCreateClicked" />

        <SearchBar Grid.Row="1"
                   Placeholder="Поиск по названию или тексту"
                   TextChanged="OnSearchTextChanged" />

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding VisibleNotes}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" Spacing="8">
                    <Label Text="Заметки не найдены"
                           HorizontalOptions="Center"
                           FontSize="16" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:NoteItem">
                    <Border StrokeThickness="1"
                            Stroke="#D0D0D0"
                            StrokeShape="RoundRectangle 10"
                            Padding="12"
                            Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="18" />

                            <Label Text="{Binding Text}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />

                            <Label Text="{Binding DateTime, StringFormat='Дата: {0:dd.MM.yyyy HH:mm}'}"
                                   FontSize="12"
                                   TextColor="#6A6A6A" />

                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Редактировать"
                                        Clicked="OnEditClicked"
                                        CommandParameter="{Binding Id}" />

                                <Button Text="Удалить"
                                        Clicked="OnDeleteClicked"
                                        CommandParameter="{Binding Id}"
                                        BackgroundColor="#D9534F"
                                        TextColor="White" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
