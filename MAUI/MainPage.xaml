<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MAUI"
             x:Class="MAUI.MainPage"
             x:DataType="local:MainPage"
             Title="Ежедневник">

    <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Grid.Column="0"
                    Text="Создать заметку"
                    Clicked="OnCreateClicked"
                    BackgroundColor="{DynamicResource AppPrimaryColor}"
                    FontFamily="{DynamicResource AppFontFamily}"
                    FontSize="{DynamicResource AppFontSize}" />

            <Button Grid.Column="1"
                    Text="Настройки"
                    Clicked="OnSettingsClicked"
                    BackgroundColor="{DynamicResource AppPrimaryColor}"
                    FontFamily="{DynamicResource AppFontFamily}"
                    FontSize="{DynamicResource AppFontSize}" />
        </Grid>

        <SearchBar Grid.Row="1"
                   Placeholder="Поиск по названию или тексту"
                   TextChanged="OnSearchTextChanged" />

        <Label Grid.Row="2"
               Text="Дата в настройках: {Binding CurrentDateLabel}"
               TextColor="{DynamicResource AppSecondaryTextColor}"
               FontFamily="{DynamicResource AppFontFamily}"
               FontSize="12" />

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding VisibleNotes}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" Spacing="8">
                    <Label Text="Заметки не найдены"
                           HorizontalOptions="Center"
                           FontSize="16" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:NoteItem">
                    <Border StrokeThickness="1"
                            Stroke="{DynamicResource AppCardBorderColor}"
                            StrokeShape="RoundRectangle 10"
                            Padding="12"
                            Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Title}"
                                   Style="{StaticResource NoteTitleStyle}" />

                            <Label Text="{Binding Text}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="{DynamicResource AppFontSize}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2" />

                            <Label Text="{Binding ScheduledAt, StringFormat='Назначено: {0:dd.MM.yyyy HH:mm}'}"
                                   FontSize="12"
                                   TextColor="#6A6A6A" />

                            <Label Text="{Binding UpdatedAt, StringFormat='Изменено: {0:dd.MM.yyyy HH:mm}'}"
                                   FontSize="12"
                                   TextColor="#6A6A6A" />

                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Редактировать"
                                        Clicked="OnEditClicked"
                                        CommandParameter="{Binding Id}" />

                                <Button Text="Удалить"
                                        Clicked="OnDeleteClicked"
                                        CommandParameter="{Binding Id}"
                                        BackgroundColor="{DynamicResource AppDangerColor}"
                                        TextColor="White" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
