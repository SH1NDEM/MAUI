<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI.NoteEditorPage"
             Title="Заметка">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="Название"
                   FontFamily="{DynamicResource AppFontFamily}"
                   FontSize="{DynamicResource AppFontSize}" />
            <Entry x:Name="TitleEntry"
                   Placeholder="Введите название"
                   FontFamily="{DynamicResource AppFontFamily}"
                   FontSize="{DynamicResource AppFontSize}" />

            <Label Text="Текст заметки"
                   FontFamily="{DynamicResource AppFontFamily}"
                   FontSize="{DynamicResource AppFontSize}" />
            <Editor x:Name="TextEditor"
                    Placeholder="Введите текст"
                    AutoSize="TextChanges"
                    FontFamily="{DynamicResource AppFontFamily}"
                    FontSize="{DynamicResource AppFontSize}"
                    MinimumHeightRequest="140" />

            <Label Text="Дата"
                   FontFamily="{DynamicResource AppFontFamily}"
                   FontSize="{DynamicResource AppFontSize}" />
            <DatePicker x:Name="DatePicker" />

            <Label Text="Время"
                   FontFamily="{DynamicResource AppFontFamily}"
                   FontSize="{DynamicResource AppFontSize}" />
            <TimePicker x:Name="TimePicker" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                <Button Grid.Column="0"
                        Text="Отмена"
                        Clicked="OnCancelClicked"
                        BackgroundColor="{DynamicResource AppDangerColor}" />

                <Button Grid.Column="1"
                        Text="Сохранить"
                        Clicked="OnSaveClicked"
                        BackgroundColor="{DynamicResource AppPrimaryColor}"
                        TextColor="White" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
